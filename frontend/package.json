{
  "name": "habitloop-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "svelte-kit sync",
    "dev": "vite dev",
    "prebuild": "svelte-kit sync",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.2.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@habitloop/components": "file:../components-stencil"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
