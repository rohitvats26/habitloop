# Frontend build-time API base URLs (Vite inlines these at `npm run build`).
# Local dev: the per-service ports (these are also the in-code defaults, so a local run needs no .env).
VITE_USER_SERVICE_URL=http://localhost:8081
VITE_ACTIVITY_SERVICE_URL=http://localhost:8082
VITE_CHALLENGE_SERVICE_URL=http://localhost:8083
VITE_INTEGRATION_SERVICE_URL=http://localhost:8084
VITE_ANALYTICS_SERVICE_URL=http://localhost:8085
VITE_RECOMMENDATION_SERVICE_URL=http://localhost:8086

# Production (S3): set ALL of the above to the ALB URL, e.g.
# VITE_USER_SERVICE_URL=http://habitloop-dev-alb-xxxx.ap-south-1.elb.amazonaws.com
# (the ALB path-routes /api/* to each service, so one URL for all is correct).
