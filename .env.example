# Copy to .env before running docker compose. Do NOT commit real secrets.
# Shared JWT signing secret (must be >= 32 bytes). Same value across all services.
JWT_SECRET=local-dev-habitloop-jwt-secret-change-me-32bytes-min

# Local pgAdmin browser login (change for shared/non-local environments).
PGADMIN_DEFAULT_EMAIL=admin@habitloop.local
PGADMIN_DEFAULT_PASSWORD=local-dev-pgadmin-password
